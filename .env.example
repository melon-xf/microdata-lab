# Optional licensed-source credentials. Never commit real values.
IPUMS_API_KEY=
CENSUS_API_KEY=
FRED_API_KEY=

# BLS contact is written by scripts/configure_bls_contact.py; do not hand-edit
# a real value into a committed file.
BLS_USER_AGENT=

# Optional data-lake override. Default: ~/.local/share/microdata-lab
MICRODATA_ROOT=

# Optional protected dotenv path. Set this to a user-owned protected file.
# MICRODATA_ENV_FILE=/absolute/path/to/protected/.env
